<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:2fl+Ktvk99x9F8pKbGz9mWdFnNbHk2y2h8g0p7vKxkE="/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- force="true": el contenedor define DB_* en su entorno (docker-compose)
             y sin force PHPUnit no sobreescribe variables ya presentes, con lo que
             los tests apuntarian a la BD de desarrollo. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="database" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="redprint_test" force="true"/>
        <env name="DB_USERNAME" value="redprint" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
    </php>
</phpunit>
