APP_NAME=RedPrint
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=redprint
DB_USERNAME=redprint
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

# Dominios "stateful" de Sanctum (SPA auth por cookies).
# IMPORTANTE: deben incluir el host CON y SIN puerto del origen del frontend,
# o el login no persistira la sesion (/auth/user -> 401).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,localhost:8080,127.0.0.1,127.0.0.1:8000,127.0.0.1:8080

FRONTEND_URL=http://localhost

CACHE_STORE=database
QUEUE_CONNECTION=database
