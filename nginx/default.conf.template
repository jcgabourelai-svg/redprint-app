upstream php-fpm {
    server app:9000;
}

server {
    listen 80;
    server_name ${APP_DOMAIN:-localhost};
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20M;

    error_log /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;

    location /api/ {
        root /var/www/html/public;
        try_files $uri $uri/ /index.php?$query_string;
        fastcgi_pass php-fpm;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        include fastcgi_params;
    }

    location /sanctum/ {
        root /var/www/html/public;
        try_files $uri $uri/ /index.php?$query_string;
        fastcgi_pass php-fpm;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        include fastcgi_params;
    }

    location /storage/ {
        root /var/www/html/public;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # App movil (mobile/dist montado en /usr/share/nginx/m). Se usa root hacia
    # /usr/share/nginx (no alias) porque /m/ ya existe como montura en esa raiz;
    # asi se evita tanto el problema de anidar monturas bajo el dist del frontend
    # (solo lectura) como los bugs conocidos de alias + try_files.
    location /m/assets/ {
        root /usr/share/nginx;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /m/ {
        root /usr/share/nginx;
        try_files $uri $uri/ /m/index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location ~ \.php$ {
        root /var/www/html/public;
        fastcgi_pass php-fpm;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        include fastcgi_params;
    }
}
